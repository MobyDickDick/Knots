<!doctype html>
<!-- Internal export template. Open examples/knot_gallery.html for the gallery. -->
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Knots · Knoten in zwei Schichten</title>
<style>
:root { color-scheme: light; --paper:#f7f6f2; --ink:#243632; --muted:#66716b; --line:#d9dfd8; --blue:#1f77b4; --green:#2ca02c; --red:#d62728; }
* { box-sizing:border-box; }
[hidden] { display:none !important; }
body { margin:0; background:var(--paper); color:var(--ink); font:15px/1.5 system-ui,sans-serif; }
header { padding:26px 40px 20px; border-bottom:1px solid var(--line); display:flex; align-items:center; gap:26px; }
.brand { font-size:23px; font-weight:750; letter-spacing:-1px; }
.brand span { color:var(--green); }
.eyebrow { text-transform:uppercase; font-size:11px; letter-spacing:2px; color:var(--muted); }
main { max-width:1560px; margin:auto; padding:32px 40px 40px; }
h1 { font:400 clamp(28px,3vw,42px)/1.2 Georgia,serif; margin:0 0 8px; }
.intro { margin:0 0 28px; color:var(--muted); }
.layout { display:grid; grid-template-columns:350px minmax(0,1fr); gap:30px; align-items:start; }
.list-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; }
h2 { font-size:14px; margin:0; font-weight:650; }
#count { color:var(--muted); font-size:12px; }
#knots { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; max-height:690px; overflow:auto; padding:2px 5px 6px 2px; }
button,input { font:inherit; }
button { cursor:pointer; }
button:disabled { cursor:default; opacity:0.65; }
.knot-card { background:#fff; border:1px solid var(--line); border-radius:12px; padding:8px 10px 12px; text-align:left; color:var(--ink); text-decoration:none; }
.knot-card:hover { border-color:#7a9388; }
.knot-card[aria-pressed=true] { border:2px solid #356653; padding:7px 9px 11px; background:#eef4ef; }
button:focus-visible,input:focus-visible,canvas:focus-visible { outline:3px solid #b68b36; outline-offset:3px; }
.knot-card canvas { width:100%; height:108px; display:block; pointer-events:none; }
.knot-card svg { width:100%; height:108px; display:block; }
#static-preview { height:100%; padding:30px; }
#static-preview svg { width:100%; height:100%; }
#static-catalog { margin-top:20px; }
#static-catalog section { border-top:1px solid var(--line); padding:12px 0; scroll-margin-top:16px; }
#static-catalog h3 { font-size:15px; margin:4px 0 12px; }
#static-catalog svg { width:100%; height:300px; }
#gallery-status { margin:0 0 20px; padding:12px 16px; background:#edf2eb; border-radius:8px; }
.knot-name { display:block; font-weight:650; }
.knot-caption { color:var(--muted); font-size:11px; }
.viewer { background:#fff; border:1px solid var(--line); border-radius:18px; overflow:hidden; }
.viewer-head { padding:21px 24px; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; border-bottom:1px solid var(--line); }
#selected-name { font:400 28px/1.2 Georgia,serif; margin:2px 0 0; }
.modes { display:flex; gap:4px; border-radius:9px; background:#eff2ed; padding:4px; }
.modes button { border:0; border-radius:6px; background:transparent; padding:7px 13px; color:var(--muted); font-size:13px; }
.modes button[aria-pressed=true] { background:#294e40; color:white; }
.stage { height:460px; position:relative; background:radial-gradient(ellipse at center,#fff 35%,#f5f7f3); }
#scene { display:block; width:100%; height:100%; touch-action:none; cursor:grab; }
#scene:active { cursor:grabbing; }
.stage-tag { position:absolute; left:24px; top:16px; color:var(--muted); font-size:11px; letter-spacing:1px; pointer-events:none; }
.toolbar { display:flex; flex-wrap:wrap; gap:12px 22px; padding:15px 24px; align-items:center; border-top:1px solid var(--line); font-size:12px; }
.toolbar label { display:flex; align-items:center; gap:7px; }
.toolbar input[type=range] { width:95px; accent-color:#356653; }
.toolbar input[type=checkbox] { accent-color:#356653; }
.toolbar button { border:1px solid var(--line); background:white; border-radius:6px; padding:5px 10px; color:var(--ink); }
.legend { display:flex; flex-wrap:wrap; gap:18px; padding:0 24px 15px; color:var(--muted); font-size:12px; }
.legend span { display:flex; align-items:center; gap:6px; }
.swatch { width:17px; height:4px; border-radius:3px; background:var(--color); }
.details { display:flex; flex-wrap:wrap; gap:20px; margin-top:16px; color:var(--muted); font-size:12px; }
.details strong { color:var(--ink); font-weight:600; }
#help { margin:10px 0 0; font-size:12px; color:var(--muted); }
.note { margin-top:24px; padding-top:14px; border-top:1px solid var(--line); color:var(--muted); font-size:12px; }
@media(max-width:900px) { header {padding:20px;} main {padding:24px 20px;} .layout {grid-template-columns:240px minmax(0,1fr);gap:18px;} #knots {grid-template-columns:1fr;} .stage {height:410px;} }
@media(max-width:620px) { header {gap:16px;} .layout {display:flex;flex-direction:column;} .catalog {width:100%;} #knots {display:flex;max-height:none;overflow-x:auto;} .knot-card {min-width:130px;} .knot-card canvas {height:85px;} .detail {width:100%;} .stage {height:350px;} .viewer-head {padding:16px;} .toolbar {padding:14px 16px;} .legend {padding-left:16px;} }
</style>
</head>
<body>
<header><div class="brand">Knots<span>.</span></div><div class="eyebrow">Gitter · Projektion · Raum</div></header>
<main>
<h1>Knoten in zwei Schichten.</h1>
<p class="intro">Ein Katalog, zwei Ansichten. Wähle einen Knoten und erkunde seinen Weg durch das Gitter.</p>
<p id="gallery-status" role="status">Die 2-D-Vorschauen sind bereit. Falls die interaktive Ansicht nicht startet, öffne diese Datei in einem Browser mit aktiviertem JavaScript.</p>
<div class="layout">
<section class="catalog" aria-label="Knotenkatalog">
<div class="list-heading"><h2>Die Sammlung</h2><span id="count">__KNOT_COUNT__ Knoten</span></div>
<div id="knots">__KNOT_CARDS__</div>
</section>
<section class="detail" aria-label="Ausgewählter Knoten">
<div class="viewer">
<div class="viewer-head"><div><div class="eyebrow">Ausgewählter Knoten</div><h2 id="selected-name">__SELECTED_NAME__</h2></div>
<div class="modes" role="group" aria-label="Darstellung"><button id="mode-2d" disabled aria-pressed="true">2-D · Dein Format</button><button id="mode-3d" disabled aria-pressed="false">3-D · Drehbar</button></div></div>
<div class="stage"><div class="stage-tag" id="stage-label"></div><div id="static-preview">__SELECTED_PREVIEW__</div><canvas id="scene" hidden tabindex="0" aria-label="Drehbare Knotendarstellung"></canvas></div>
<div class="toolbar">
<label><input id="grid" disabled type="checkbox" checked> Gitter</label>
<label id="gap-control">Schichtabstand <input id="gap" disabled type="range" min="0.5" max="4" value="1" step="0.1"><output id="gap-value">1,0</output></label>
<button id="reset" disabled>Ansicht zurücksetzen</button>
</div>
<div class="legend"><span><i class="swatch" style="--color:var(--blue)"></i>Schicht 0</span><span><i class="swatch" style="--color:var(--green)"></i>Schicht 1</span><span><i class="swatch" style="--color:var(--red)"></i>Ebenenwechsel</span></div>
</div>
<div class="details" id="details" aria-live="polite"></div>
<p id="help"></p>
<div id="static-catalog">__STATIC_CATALOG__</div>
</section>
</div>
<p class="note">Die Knotenpunkte liegen auf z = 0 und z = 1. Der Schichtabstand verändert nur die räumliche Ansicht; die Gitterkoordinaten bleiben erhalten.</p>
<noscript>Bitte JavaScript aktivieren, um die Knoten auszuwählen und räumlich zu drehen.</noscript>
</main>
<script>
(() => {
  'use strict';
  const $ = id => document.getElementById(id);
  const staticCards = Array.from($('knots').children);
  const controlIds=['mode-2d','mode-3d','grid','gap','reset'];
  function showStartupError(error) {
    controlIds.forEach(id=>{$(id).disabled=true;});
    $('knots').replaceChildren(...staticCards);
    $('scene').hidden=true;
    $('static-preview').hidden=false;
    $('static-catalog').hidden=false;
    $('gallery-status').hidden=false;
    $('gallery-status').textContent='Die interaktive Ansicht konnte nicht starten: '+error.message+'. Die 2-D-Knoten bleiben unten verfügbar.';
  }
  try {
  const knots = /* KNOT_DATA_START */__KNOT_DATA__/* KNOT_DATA_END */;
  if(!Array.isArray(knots) || !knots.length) throw new Error('Keine gültigen Knotendaten vorhanden');
  const scene = $('scene');
  const colors = ['#1f77b4', '#2ca02c', '#d62728'];
  let selected = knots.length > 1 ? 1 : 0;
  let mode = '3d', yaw = -0.5, tilt = 0.9, zoom = 1;
  let drag = null;
  const cards = [];
  const offset = Math.SQRT2 / 2;

  function bounds(points) {
    return points.reduce((b, p) => [Math.min(b[0],p[0]), Math.max(b[1],p[0]), Math.min(b[2],p[1]), Math.max(b[3],p[1])], [Infinity,-Infinity,Infinity,-Infinity]);
  }
  function setupCanvas(canvas) {
    const rect = canvas.getBoundingClientRect(), ratio = window.devicePixelRatio || 1;
    canvas.width = Math.round(rect.width * ratio);
    canvas.height = Math.round(rect.height * ratio);
    const ctx = canvas.getContext('2d');
    ctx.setTransform(ratio,0,0,ratio,0,0);
    return {ctx, width:rect.width, height:rect.height};
  }
  function draw(canvas, knot, flat, mini = false) {
    const {ctx,width,height} = setupCanvas(canvas);
    if (!width || !height) return;
    const b = bounds(knot.points), cx = (b[0]+b[1])/2, cy = (b[2]+b[3])/2;
    const gap = Number($('gap').value);
    function project(p) {
      if (flat) return [p[0]+p[2]*offset-cx-offset/2, -p[1]-p[2]*offset+cy+offset/2, p[2]];
      const x=p[0]-cx, y=p[1]-cy, z=(p[2]-0.5)*gap;
      const u=x*Math.cos(yaw)-y*Math.sin(yaw), v=x*Math.sin(yaw)+y*Math.cos(yaw);
      return [u, -v*Math.cos(tilt)-z*Math.sin(tilt), -v*Math.sin(tilt)+z*Math.cos(tilt)];
    }
    const corners=[];
    for (const x of [b[0]-0.7,b[1]+0.7]) for (const y of [b[2]-0.7,b[3]+0.7]) for (const z of [0,1]) corners.push(project([x,y,z]));
    const extent=bounds(corners);
    const scale=Math.min((width-(mini?12:75))/Math.max(1,extent[1]-extent[0]),(height-(mini?12:65))/Math.max(1,extent[3]-extent[2]))*(mini?1:zoom);
    const screen=p=>{ const q=project(p); return [width/2+q[0]*scale,height/2+q[1]*scale,q[2]]; };
    function stroke(a,b,color,lineWidth) {
      ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.strokeStyle=color;ctx.lineWidth=lineWidth;ctx.lineCap='round';ctx.stroke();
    }
    if (!mini && $('grid').checked) {
      // Bound grid density for large catalogs, without dropping knot edges.
      const step=Math.max(1,Math.ceil(Math.max(b[1]-b[0],b[3]-b[2])/28));
      for (const z of [0,1]) {
        const color=z===0?'rgba(60,80,72,0.16)':'rgba(60,80,72,0.09)';
        for(let x=b[0];x<=b[1];x+=step) stroke(screen([x,b[2],z]),screen([x,b[3],z]),color,0.8);
        for(let y=b[2];y<=b[3];y+=step) stroke(screen([b[0],y,z]),screen([b[1],y,z]),color,0.8);
      }
    }
    const edges=[];
    for(let i=0;i<knot.points.length-1;i++) {
      const a=knot.points[i],b=knot.points[i+1],pa=screen(a),pb=screen(b);
      edges.push({a:pa,b:pb,depth:(pa[2]+pb[2])/2,color:colors[a[2]!==b[2]?2:a[2]]});
    }
    edges.sort((a,b)=>a.depth-b.depth);
    const lineWidth=mini?2.5:Math.max(2.3,Math.min(6,scale*0.16));
    for(const edge of edges) {
      if(!mini) stroke(edge.a,edge.b,'#ffffff',lineWidth+2.8);
      stroke(edge.a,edge.b,edge.color,lineWidth);
    }
  }
  function redraw() { draw(scene,knots[selected],mode==='2d'); }
  function refreshMode() {
    $('mode-2d').setAttribute('aria-pressed',String(mode==='2d'));
    $('mode-3d').setAttribute('aria-pressed',String(mode==='3d'));
    $('gap-control').hidden=mode==='2d';
    $('gap').disabled=mode==='2d';
    $('stage-label').textContent=mode==='2d'?'VERSCHOBENE GITTERPROJEKTION':'ZWEI EBENEN IM RAUM';
    $('help').textContent=mode==='2d'?'Obere Schicht um √2 / 2 diagonal verschoben · Mausrad zum Zoomen.':'Ziehen zum Drehen · Mausrad zum Zoomen · Pfeiltasten drehen, + / − zoomen.';
    scene.setAttribute('aria-label',mode==='2d'?'Verschobene Zweischichtprojektion':'Drehbare 3-D-Ansicht; mit Pfeiltasten drehen');
    redraw();
  }
  function choose(index) {
    selected=index;
    cards.forEach((card,i)=>card.setAttribute('aria-pressed',String(i===selected)));
    const knot=knots[selected];
    $('selected-name').textContent=knot.name==='0_1'?'0₁ · Unknoten':knot.name;
    $('details').replaceChildren();
    for(const [label,value] of [['Kreuzungen',knot.crossings],['Gitterkanten',knot.points.length-1],['Determinante',knot.determinant]]) {
      const span=document.createElement('span'), strong=document.createElement('strong');
      strong.textContent=String(value);span.append(strong,document.createTextNode(' '+label));$('details').append(span);
    }
    redraw();
  }
  $('count').textContent=knots.length+' Knoten';
  knots.forEach((knot,index)=>{
    const card=document.createElement('button');card.className='knot-card';card.type='button';
    card.setAttribute('aria-pressed','false');card.setAttribute('aria-label',knot.name+' auswählen');
    const canvas=document.createElement('canvas');canvas.setAttribute('aria-hidden','true');
    const name=document.createElement('span');name.className='knot-name';name.textContent=knot.name==='0_1'?'0₁ · Unknoten':knot.name;
    const caption=document.createElement('span');caption.className='knot-caption';caption.textContent=knot.crossings+' Kreuzungen';
    card.append(canvas,name,caption);card.addEventListener('click',()=>choose(index));cards.push(card);
  });
  $('mode-2d').addEventListener('click',()=>{mode='2d';zoom=1;refreshMode();});
  $('mode-3d').addEventListener('click',()=>{mode='3d';zoom=1;refreshMode();});
  $('grid').addEventListener('change',redraw);
  $('gap').addEventListener('input',()=>{$('gap-value').textContent=Number($('gap').value).toFixed(1).replace('.',',');redraw();});
  $('reset').addEventListener('click',()=>{yaw=-0.5;tilt=0.9;zoom=1;$('gap').value='1';$('gap-value').textContent='1,0';redraw();});
  scene.addEventListener('pointerdown',event=>{if(mode==='3d'){drag={x:event.clientX,y:event.clientY,id:event.pointerId};scene.setPointerCapture(event.pointerId);}});
  scene.addEventListener('pointermove',event=>{
    if(!drag || drag.id!==event.pointerId)return;
    yaw+=(event.clientX-drag.x)*0.009;tilt+=(event.clientY-drag.y)*0.009;
    drag.x=event.clientX;drag.y=event.clientY;redraw();
  });
  for(const event of ['pointerup','pointercancel','lostpointercapture']) scene.addEventListener(event,()=>{drag=null;});
  scene.addEventListener('wheel',event=>{event.preventDefault();zoom=Math.max(0.4,Math.min(3,zoom*Math.exp(-event.deltaY*0.001)));redraw();},{passive:false});
  scene.addEventListener('keydown',event=>{
    let handled=true;
    if(mode==='3d' && event.key==='ArrowLeft')yaw-=0.12;
    else if(mode==='3d' && event.key==='ArrowRight')yaw+=0.12;
    else if(mode==='3d' && event.key==='ArrowUp')tilt-=0.12;
    else if(mode==='3d' && event.key==='ArrowDown')tilt+=0.12;
    else if(event.key==='+')zoom=Math.min(3,zoom*1.1);
    else if(event.key==='-')zoom=Math.max(0.4,zoom/1.1);
    else handled=false;
    if(handled){event.preventDefault();redraw();}
  });
  $('static-preview').hidden=true;
  scene.hidden=false;
  choose(selected);refreshMode();
  $('knots').replaceChildren(...cards);
  const resize=()=>{redraw();cards.forEach((card,i)=>draw(card.querySelector('canvas'),knots[i],true,true));};
  resize();
  if(typeof ResizeObserver!=='undefined') {
    new ResizeObserver(resize).observe($('knots'));
    new ResizeObserver(redraw).observe(scene);
  } else {
    window.addEventListener('resize',resize);
  }
  $('static-catalog').hidden=true;
  $('gallery-status').hidden=true;
  controlIds.forEach(id=>{$(id).disabled=false;});
  } catch(error) {
    showStartupError(error);
  }
})();
</script>
</body>
</html>
